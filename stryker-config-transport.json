{
  "stryker-config": {
    "project": "NinePSharp.Server.csproj",
    "test-projects": [
      "NinePSharp.Tests.csproj"
    ],
    "mutate": [
      "NinePConnectionProcessor.cs"
    ],
    "mutation-level": "Standard",
    "ignore-mutations": [
      "String"
    ],
    "ignore-methods": [
      "LogInformation",
      "LogWarning",
      "LogError",
      "LogDebug"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "concurrency": 4
  }
}
