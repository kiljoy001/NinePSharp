<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <ProjectReference Include="../../NinePSharp.Namespaces/NinePSharp.Namespaces.csproj" />
    <Reference Include="WebAssembly">
      <HintPath>$(WasmSource)/WebAssembly/bin/Release/net9.0/WebAssembly.dll</HintPath>
    </Reference>
    <Compile Include="../../NinePSharp.Namespaces.Tests/Support/MemoryDataResources.cs" Link="Support/MemoryDataResources.cs" />
  </ItemGroup>
  <Target Name="RequireRuntimeSource" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(WasmSource)/WebAssembly/bin/Release/net9.0/WebAssembly.dll')"
           Text="Run bash scripts/check-wasm-compatibility.sh /absolute/path/to/dotnet-webassembly first." />
  </Target>
</Project>
