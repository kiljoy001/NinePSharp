{
  "stryker-config": {
    "project": "NinePSharp.Namespaces.Orleans.csproj",
    "test-projects": [
      "NinePSharp.Namespaces.Orleans.Tests.csproj"
    ],
    "mutate": [
      "ResourceProviderRegistration.cs",
      "OrleansResourceOperations.cs",
      "DistributedNamespaceOperations.cs",
      "OrleansWStatRecoveryStore.cs",
      "WStatRecoveryJournalGrain.cs"
    ],
    "mutation-level": "Standard",
    "ignore-mutations": [
      "String"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "concurrency": 4
  }
}
