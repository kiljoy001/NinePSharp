{
  "stryker-config": {
    "project": "NinePSharp.Namespaces.csproj",
    "test-projects": [
      "NinePSharp.Namespaces.Tests.csproj"
    ],
    "mutate": [
      "MountFlags.cs",
      "MountTable.cs",
      "NamespaceDataPlane.cs",
      "NamespaceNavigation.cs",
      "NamespaceSession.cs",
      "NamespaceSyscalls.cs",
      "ResourceDataOperations.cs",
      "ResourceHandle.cs",
      "VirtualProcesses.cs"
    ],
    "mutation-level": "Standard",
    "ignore-mutations": [
      "String"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 95,
      "low": 90,
      "break": 90
    },
    "concurrency": 4
  }
}
