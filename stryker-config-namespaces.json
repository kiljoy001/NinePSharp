{
  "stryker-config": {
    "project": "NinePSharp.Namespaces.csproj",
    "test-projects": [
      "NinePSharp.Namespaces.Tests.csproj"
    ],
    "mutate": [
      "MountFlags.cs",
      "MountTable.cs",
      "NamespaceDataPlane.cs",
      "NamespaceNavigation.cs",
      "NamespaceSession.cs",
      "NamespaceControlResource.cs",
      "NamespaceSyscalls.cs",
      "ResourceDataOperations.cs",
      "ResourceHandle.cs",
      "VirtualProcesses.cs",
      "DescriptorGroup.cs",
      "Plan9FileSyscalls.cs",
      "Plan9CreateRequest.cs",
      "DirectoryCursor.cs",
      "DirectoryStreams.cs",
      "DirectoryMounts.cs",
      "DirectoryStatOperations.cs",
      "FileStatOperations.cs",
      "WStatRecovery.cs"
    ],
    "mutation-level": "Standard",
    "ignore-mutations": [
      "String"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "concurrency": 4
  }
}
